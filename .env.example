APP_NAME="Urja Meter Ops API"
APP_VERSION="1.0.0"
APP_ENV="development"
LOG_LEVEL="INFO"
API_PREFIX="/api/v1"

# Legacy Portal Configuration
URJA_BASE_URL="https://urja-ops.flockenergy.tech"
URJA_USERNAME="operator@urja.local"
URJA_PASSWORD="your-portal-password-here"

# Upstream Client Settings
UPSTREAM_TIMEOUT_SECONDS=15.0
UPSTREAM_MAX_RETRIES=1

# Local Mock / Fixture Mode (set to true to run fully offline without live portal)
MOCK_MODE=false
